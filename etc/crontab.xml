<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Every minute: Cloudflare's Free-plan purge limit is per minute, so this is both the
             latency and the budget window. -->
        <job name="webcode_cloudflare_purge"
             instance="Webcode\CloudflarePurge\Cron\ProcessQueue"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
